# syntax=docker/dockerfile:1
# Packs a prebuilt static binary from dist/linux-<arch>/ into a scratch image.
FROM --platform=$BUILDPLATFORM rust:1.99.1-slim-trixie@sha256:f6c4a35d21dbb3c89d7a8d056c193e94fc09037f2b58dd858b09c39a47dd02d7 AS rootfs
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /rootfs/etc/ssl/certs /rootfs/usr/share /rootfs/config /data-dir \
 && cp /etc/ssl/certs/ca-certificates.crt /rootfs/etc/ssl/certs/ \
 && cp -r /usr/share/zoneinfo /rootfs/usr/share/zoneinfo \
 && echo "nonroot:x:65532:65532:nonroot:/data:/sbin/nologin" > /rootfs/etc/passwd \
 && echo "nonroot:x:65532:" > /rootfs/etc/group \
 && chmod 700 /data-dir

FROM scratch
ARG TARGETARCH
COPY --from=rootfs /rootfs/ /
COPY --from=rootfs --chown=65532:65532 /data-dir /data
COPY --chmod=755 dist/linux-${TARGETARCH}/hq-watchman /usr/local/bin/hq-watchman
USER 65532:65532
WORKDIR /data
VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 CMD ["/usr/local/bin/hq-watchman", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/hq-watchman"]
CMD ["run", "--config", "/config/config.toml"]
